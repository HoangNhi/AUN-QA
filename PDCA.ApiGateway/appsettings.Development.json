{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "system-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/system/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/system" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "business-route": {
        "ClusterId": "business-cluster",
        "Match": {
          "Path": "/business/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/business" }
        ]
      },
      "file-api-route": {
        "ClusterId": "file-api-cluster",
        "Match": {
          "Path": "/file/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/file/api" }
        ]
      },
      "file-static-route": {
        "ClusterId": "file-static-cluster",
        "Match": {
          "Path": "/file/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/file" }
        ]
      }
    },
    "Clusters": {
      "system-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7073/api"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7128/api"
          }
        }
      },
      "business-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7076/api"
          }
        }
      },
      "file-api-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7185/api"
          }
        }
      },
      "file-static-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7185/"
          }
        }
      }
    }
  }
}