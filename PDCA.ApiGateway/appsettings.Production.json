{
  "Cors": {
    "Origins": [ "https://www.pdcaflow.pw" ]
  },
  "ReverseProxy": {
    "Routes": {
      "system-route": {
        "ClusterId": "system-cluster",
        "Match": { "Path": "/system/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/system" } ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "business-route": {
        "ClusterId": "business-cluster",
        "Match": { "Path": "/business/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/business" } ]
      },
      "file-api-route": {
        "ClusterId": "file-api-cluster",
        "Match": { "Path": "/file/api/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/file/api" } ]
      },
      "file-static-route": {
        "ClusterId": "file-static-cluster",
        "Match": { "Path": "/file/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/file" } ]
      }
    },
    "Clusters": {
      "system-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://aun-qa-system-ac8c96245b3a.herokuapp.com/api" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://aun-qa-catalog-a333bf6cd873.herokuapp.com/api" }
        }
      },
      "business-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://aun-qa-business-629b6b424e18.herokuapp.com/api" }
        }
      },
      "file-api-cluster": {
        "Destinations": {
          "d1": { "Address": "https://aun-qa-file.duckdns.org/api" }
        }
      },
      "file-static-cluster": {
        "Destinations": {
          "d1": { "Address": "https://aun-qa-file.duckdns.org/" }
        }
      }
    }
  }
}
